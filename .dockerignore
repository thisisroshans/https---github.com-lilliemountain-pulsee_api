# Anything not needed to build or run the API. Keeping this tight matters for
# more than image size: without it, .env would be baked into an image layer.

.env
.env.*
!.env.example

node_modules
dist
coverage
.pnpm-store

.git
.github
.husky
.vscode
.idea

test
docs
*.md
!README.md

Dockerfile
docker-compose.yml
.dockerignore
*.log
