// Pulse — database schema.
// Conventions (see docs/BACKEND_HANDOFF.md §5):
//   • tables plural snake_case, columns snake_case (mapped to camelCase in TS)
//   • UUID v7 primary keys generated app-side (time-sortable, safe to expose)
//   • every table carries created_at / updated_at; timestamps stored in UTC
//   • user-owned content that may need recovery uses deleted_at (soft delete)
//
// This scaffold models the auth + identity core. Feature domains (plans, meals,
// food logs, coach, progress, subscriptions) are added by their own slices.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPPORT
}

enum Entitlement {
  FREE
  PREMIUM
}

model User {
  id              String      @id @db.Uuid
  phone           String      @unique @db.VarChar(16)
  /// Firebase Auth uid. Phone remains the natural key — a number re-registered
  /// in Firebase gets a fresh uid but must map back to the same Pulse account.
  firebaseUid     String?     @unique @map("firebase_uid") @db.VarChar(128)
  phoneVerifiedAt DateTime?   @map("phone_verified_at") @db.Timestamptz(3)
  displayName     String?     @map("display_name") @db.VarChar(80)
  timezone        String      @default("Asia/Kolkata") @db.VarChar(64)
  locale          String      @default("en-IN") @db.VarChar(10)
  roles           UserRole[]  @default([USER])
  entitlement     Entitlement @default(FREE)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  /// Set when the user finishes screen 6. Drives whether the app resumes
  /// onboarding or goes straight to Home.
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)

  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  profile           Profile?
  goals             UserGoal[]
  healthProfile     HealthProfile?
  dietPreference    DietPreference?
  supplements       UserSupplement[]
  workoutPreference WorkoutPreference?
  workoutSessions   WorkoutSession[]
  setLogs           SetLog[]

  // Partial index: the vast majority of reads exclude soft-deleted users.
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

/// Opaque refresh tokens. Only the argon2 hash is stored. Rotated on every use;
/// reuse of a revoked token revokes the whole family (theft response).
model RefreshToken {
  id        String @id @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @map("token_hash") @db.VarChar(255)
  familyId  String @map("family_id") @db.Uuid

  /// Set when this token is rotated out, pointing at its replacement. Lets us
  /// trace a family and prove reuse rather than inferring it.
  replacedById String? @unique @map("replaced_by_id") @db.Uuid

  deviceId  String?   @map("device_id") @db.VarChar(128)
  userAgent String?   @map("user_agent") @db.VarChar(512)
  ip        String?   @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Append-only record of security- and money-relevant events. Never updated,
/// never deleted; actor may be null for system-initiated actions.
model AuditLog {
  id          String  @id @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  action      String  @db.VarChar(64)
  entity      String  @db.VarChar(64)
  entityId    String? @map("entity_id") @db.VarChar(64)
  metadata    Json?
  ip          String? @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ===========================================================================
// Onboarding (screens 2-6)
//
// Everything the user tells us before a plan can be generated. Measurements are
// stored canonically (kg, cm) with the unit they entered kept alongside, so the
// app can echo values back in the units they chose without us storing two
// sources of truth.
// ===========================================================================

enum GoalType {
  LOSE_WEIGHT
  BUILD_MUSCLE
  GET_TONED
  LOSE_BELLY_FAT
  STAMINA_ENERGY
  MANAGE_CONDITION
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  VERY_ACTIVE
}

enum TargetDeadline {
  ONE_MONTH
  TWO_MONTHS
  THREE_MONTHS
  SIX_MONTHS
  ONE_YEAR
}

enum HeightUnit {
  CM
  FT_IN
}

enum WeightUnit {
  KG
  LB
}

enum HealthCondition {
  PCOS
  DIABETES_TYPE_2
  PRE_DIABETES
  HYPERTENSION
  THYROID
  HIGH_CHOLESTEROL
  IBS_DIGESTIVE
}

enum Allergen {
  LACTOSE
  GLUTEN
  NUTS
  EGGS
  SHELLFISH
  SOY
}

enum DietType {
  VEGETARIAN
  EGGETARIAN
  NON_VEGETARIAN
  VEGAN
  JAIN
}

enum BudgetTier {
  LOW
  MID
  HIGH
}

enum CookingResponsibility {
  SELF
  HOUSEHOLD
  ORDER_IN
  MIXED
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum WorkoutLocation {
  HOME_NO_EQUIPMENT
  HOME_BASIC_EQUIPMENT
  GYM
  YOGA_PILATES
  OUTDOOR
}

enum PreferredTime {
  EARLY_MORNING
  MORNING
  LUNCH
  EVENING
  NIGHT
}

enum ExperienceLevel {
  BEGINNER
  SOME
  ADVANCED
}

enum SupplementKind {
  PROTEIN
  OTHER
}

/// Screen 3. One row per user; body stats drive every calorie and macro target.
model Profile {
  userId String @id @map("user_id") @db.Uuid

  sex      Sex
  /// Age in whole years as entered. Stored rather than derived because the app
  /// asks for age, not a birth date; `updatedAt` records when it was true.
  ageYears Int @map("age_years")

  heightCm       Float          @map("height_cm")
  weightKg       Float          @map("weight_kg")
  targetWeightKg Float          @map("target_weight_kg")
  targetDeadline TargetDeadline @map("target_deadline")
  activityLevel  ActivityLevel  @map("activity_level")

  /// Units the user entered in. Display only — never used for calculation.
  heightUnit HeightUnit @default(CM) @map("height_unit")
  weightUnit WeightUnit @default(KG) @map("weight_unit")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// Screen 2. Multi-select, so one row per chosen goal.
model UserGoal {
  id     String   @id @db.Uuid
  userId String   @map("user_id") @db.Uuid
  type   GoalType

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("user_goals")
}

/// Screen 4. Sensitive: never returned to anyone but the owner.
model HealthProfile {
  userId String @id @map("user_id") @db.Uuid

  conditions  HealthCondition[]
  allergies   Allergen[]
  /// Free text, e.g. "Metformin, Thyronorm 50mcg". Length-capped at the schema.
  medications String?           @db.VarChar(500)

  tracksCycle       Boolean @default(false) @map("tracks_cycle")
  pregnantOrNursing Boolean @default(false) @map("pregnant_or_nursing")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("health_profiles")
}

/// Screen 5, excluding supplements (see UserSupplement).
model DietPreference {
  userId String @id @map("user_id") @db.Uuid

  dietType   DietType   @map("diet_type")
  cuisines   String[]
  dislikes   String[]
  budgetTier BudgetTier @map("budget_tier")

  cookedBy       CookingResponsibility @map("cooked_by")
  cookingMinutes Int                   @map("cooking_minutes")
  /// Days the user eats pure veg. Only meaningful for non-veg and eggetarian.
  vegOnlyDays    Weekday[]             @map("veg_only_days")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("diet_preferences")
}

/// Reference data. Restrict on delete: a catalog entry in use must not vanish.
model Supplement {
  id   String         @id @db.Uuid
  slug String         @unique @db.VarChar(48)
  name String         @db.VarChar(80)
  kind SupplementKind

  defaultProteinPerServingG Int     @default(0) @map("default_protein_per_serving_g")
  sortOrder                 Int     @default(0) @map("sort_order")
  isActive                  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  userSupplements UserSupplement[]

  @@index([isActive, sortOrder])
  @@map("supplements")
}

/// A user's supplement stack. Folded into their daily protein target.
model UserSupplement {
  id           String @id @db.Uuid
  userId       String @map("user_id") @db.Uuid
  supplementId String @map("supplement_id") @db.Uuid

  /// Copied from the catalog at selection time, then editable — brands differ,
  /// and a later catalog change must not silently rewrite someone's targets.
  proteinPerServingG Int @map("protein_per_serving_g")
  servingsPerDay     Int @map("servings_per_day")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplement Supplement @relation(fields: [supplementId], references: [id], onDelete: Restrict)

  @@unique([userId, supplementId])
  @@index([userId])
  @@map("user_supplements")
}

/// Screen 6.
model WorkoutPreference {
  userId String @id @map("user_id") @db.Uuid

  locations       WorkoutLocation[]
  daysPerWeek     Int               @map("days_per_week")
  sessionMinutes  Int               @map("session_minutes")
  preferredTime   PreferredTime     @map("preferred_time")
  experienceLevel ExperienceLevel   @map("experience_level")
  /// Free text, e.g. "right knee, lower back".
  injuries        String?           @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workout_preferences")
}

// ===========================================================================
// Workouts (screen 9)
//
// Two distinct things live here: the exercise *catalog* (reference data, shared
// by everyone) and a user's *training log* (what they actually did). A session
// may reference a planned workout, but logging never requires one — a user can
// train off-plan and it must still count.
// ===========================================================================

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  ABS
  OBLIQUES
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  LATS
  TRAPS
  LOWER_BACK
  REAR_DELTS
  FULL_BODY
  CARDIO
}

enum ExerciseCategory {
  PUSH
  PULL
  LEGS
  CORE
  CARDIO
  MOBILITY
}

enum Equipment {
  NONE
  DUMBBELL
  BARBELL
  MACHINE
  CABLE
  KETTLEBELL
  RESISTANCE_BAND
  BODYWEIGHT
  CARDIO_MACHINE
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

/// Reference data. `Restrict` on delete — a catalogued exercise that appears in
/// someone's training history must never silently disappear.
model Exercise {
  id       String           @id @db.Uuid
  slug     String           @unique @db.VarChar(64)
  name     String           @db.VarChar(120)
  category ExerciseCategory

  primaryMuscles   MuscleGroup[] @map("primary_muscles")
  secondaryMuscles MuscleGroup[] @map("secondary_muscles")
  equipment        Equipment[]

  /// Ordered coaching cues shown on the "How to do it" card.
  howToSteps   String[] @map("how_to_steps")
  /// Object-storage key for the demo clip; resolved to a URL at read time so
  /// the storage location can change without a migration.
  demoVideoKey String?  @map("demo_video_key") @db.VarChar(255)

  /// Whether load is meaningful. Bodyweight and cardio work have no 1RM.
  isWeighted Boolean @default(true) @map("is_weighted")
  sortOrder  Int     @default(0) @map("sort_order")
  isActive   Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  setLogs SetLog[]

  @@index([isActive, sortOrder])
  @@index([category])
  @@map("exercises")
}

/// One training session. Created when the user starts a workout.
model WorkoutSession {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid

  status            SessionStatus @default(IN_PROGRESS)
  /// Session title, e.g. "Upper body strength". Free text so an off-plan
  /// session can be named anything.
  title             String?       @db.VarChar(120)
  startedAt         DateTime      @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?     @map("completed_at") @db.Timestamptz(3)
  /// Perceived exertion, 1-10. Recorded on completion.
  perceivedExertion Int?          @map("perceived_exertion")
  notes             String?       @db.VarChar(1000)

  /// The user's local calendar day. Denormalised because "did they train
  /// today?" is asked constantly and must not re-derive a timezone each time.
  localDate String @map("local_date") @db.VarChar(10)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets SetLog[]

  @@index([userId, startedAt])
  @@index([userId, localDate])
  @@index([userId, status])
  @@map("workout_sessions")
}

/// A single logged set. The grain of the training log.
model SetLog {
  id         String @id @db.Uuid
  sessionId  String @map("session_id") @db.Uuid
  exerciseId String @map("exercise_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid

  /// 1-based position within the exercise, so sets keep their order.
  setNumber       Int     @map("set_number")
  reps            Int
  /// Null for bodyweight or cardio work.
  weightKg        Float?  @map("weight_kg")
  /// Cardio and timed holds record duration instead of reps.
  durationSeconds Int?    @map("duration_seconds")
  isWarmup        Boolean @default(false) @map("is_warmup")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, exerciseId, setNumber])
  // Drives per-exercise history and the 1RM trend without touching sessions.
  @@index([userId, exerciseId, createdAt])
  @@index([sessionId])
  @@map("set_logs")
}
