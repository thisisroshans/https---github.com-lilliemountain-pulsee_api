{
  "openapi": "3.1.0",
  "info": {
    "title": "Pulse API",
    "description": "AI diet & fitness coaching API for the Pulse mobile app.",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "summary": "Liveness probe",
        "tags": [
          "health"
        ],
        "description": "Returns 200 whenever the process is running. Touches no dependencies.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "ok"
                          ]
                        },
                        "uptimeSeconds": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "status",
                        "uptimeSeconds"
                      ],
                      "additionalProperties": false
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "summary": "Readiness probe",
        "tags": [
          "health"
        ],
        "description": "Probes Postgres and Redis. Returns 503 when any dependency is down.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "degraded"
                          ]
                        },
                        "uptimeSeconds": {
                          "type": "integer"
                        },
                        "version": {
                          "type": "string"
                        },
                        "dependencies": {
                          "type": "object",
                          "properties": {
                            "database": {
                              "type": "object",
                              "properties": {
                                "status": {
                                  "type": "string",
                                  "enum": [
                                    "up",
                                    "down"
                                  ]
                                },
                                "latencyMs": {
                                  "type": "integer",
                                  "nullable": true
                                }
                              },
                              "required": [
                                "status",
                                "latencyMs"
                              ],
                              "additionalProperties": false
                            },
                            "redis": {
                              "type": "object",
                              "properties": {
                                "status": {
                                  "type": "string",
                                  "enum": [
                                    "up",
                                    "down"
                                  ]
                                },
                                "latencyMs": {
                                  "type": "integer",
                                  "nullable": true
                                }
                              },
                              "required": [
                                "status",
                                "latencyMs"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "database",
                            "redis"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "status",
                        "uptimeSeconds",
                        "version",
                        "dependencies"
                      ],
                      "additionalProperties": false
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "degraded"
                          ]
                        },
                        "uptimeSeconds": {
                          "type": "integer"
                        },
                        "version": {
                          "type": "string"
                        },
                        "dependencies": {
                          "type": "object",
                          "properties": {
                            "database": {
                              "type": "object",
                              "properties": {
                                "status": {
                                  "type": "string",
                                  "enum": [
                                    "up",
                                    "down"
                                  ]
                                },
                                "latencyMs": {
                                  "type": "integer",
                                  "nullable": true
                                }
                              },
                              "required": [
                                "status",
                                "latencyMs"
                              ],
                              "additionalProperties": false
                            },
                            "redis": {
                              "type": "object",
                              "properties": {
                                "status": {
                                  "type": "string",
                                  "enum": [
                                    "up",
                                    "down"
                                  ]
                                },
                                "latencyMs": {
                                  "type": "integer",
                                  "nullable": true
                                }
                              },
                              "required": [
                                "status",
                                "latencyMs"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "database",
                            "redis"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "status",
                        "uptimeSeconds",
                        "version",
                        "dependencies"
                      ],
                      "additionalProperties": false
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Liveness and readiness probes"
    }
  ]
}
