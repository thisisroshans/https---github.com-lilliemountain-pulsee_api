# ---------------------------------------------------------------------------
# Pulse API — environment
# Copy to .env for local development. Never commit real secrets.
# Every variable here is validated on boot by src/config/env.ts (fail fast).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug
# Comma-separated allowlist. Use "*" only in development.
CORS_ORIGINS=*

# Publicly reachable base URL of the deployed API, e.g. https://api.pulse.fit
# Optional. When set it is added to the OpenAPI `servers` list, so Swagger UI
# offers a dropdown to run requests against the deployed environment instead of
# localhost. In production this becomes the *only* advertised server.
API_PUBLIC_URL=

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse?schema=public
# Used by the integration test suite. MUST point at a throwaway database.
TEST_DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse_test?schema=public

# --- Redis (cache, rate limits, OTP store, BullMQ) --------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000
JWT_REFRESH_PEPPER=dev-only-refresh-pepper-change-me-0000000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60

# --- OTP -------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
# When true, OTP codes are returned in the API response instead of being sent
# by SMS. Development and test only; env validation rejects it in production.
OTP_DEV_MODE=true

# --- Integrations (leave blank in dev; fakes are used) ---------------------
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_MS=30000

VISION_API_KEY=
VISION_TIMEOUT_MS=20000

S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=pulse-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
