# ---------------------------------------------------------------------------
# Pulse API — environment
# Copy to .env for local development. Never commit real secrets.
# Every variable here is validated on boot by src/config/env.ts (fail fast).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug
# Comma-separated allowlist. Use "*" only in development.
CORS_ORIGINS=*

# Publicly reachable base URL of the deployed API, e.g. https://api.pulse.fit
# Optional. When set it is added to the OpenAPI `servers` list, so Swagger UI
# offers a dropdown to run requests against the deployed environment instead of
# localhost. In production this becomes the *only* advertised server.
API_PUBLIC_URL=

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse?schema=public
# Used by the integration test suite. MUST point at a throwaway database.
TEST_DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse_test?schema=public

# --- Redis (cache, rate limits, BullMQ) ------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000
JWT_REFRESH_PEPPER=dev-only-refresh-pepper-change-me-0000000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60

# --- Firebase (phone auth) -------------------------------------------------
# Phone verification happens CLIENT-SIDE: the mobile app runs Firebase Phone
# Auth, gets an ID token, and posts it to /api/v1/auth/firebase. The backend
# only verifies that token, so these are Admin SDK service-account credentials,
# not SMS-sending credentials.
#
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. Paste the private key on ONE line, keeping its \n escapes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Local Firebase Auth emulator, e.g. 127.0.0.1:9099. Leave blank to use the real
# project. Env validation REJECTS this in production: the emulator does not
# verify token signatures, so anyone could mint a session for any phone number.
FIREBASE_AUTH_EMULATOR_HOST=

LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_MS=30000

VISION_API_KEY=
VISION_TIMEOUT_MS=20000

S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=pulse-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
